{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        ".claude/start-dev.sh"
      ],
      "port": 8888,
      "autoPort": false
    },
    {
      "name": "vite",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "export PATH=\"/opt/homebrew/bin:/usr/local/bin:$PATH\"; exec npx vite --port 5199 --strictPort"
      ],
      "port": 5199,
      "autoPort": false
    }
  ]
}
